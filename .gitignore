# Dart & Pub build output — all regenerated by `dart pub get` / `dart test`.
.dart_tool/
.packages
build/
*.snapshot
coverage/
lcov.info
doc/api/

# Flutter tool metadata
.flutter-plugins
.flutter-plugins-dependencies

# macOS Finder metadata
.DS_Store
*.DS_Store

# Editors
.idea/
.vscode/
*.iml
*.swp

# Signing keys. A key in a repo is a key you must assume is compromised, so the
# example generates its own on first `build.sh` rather than shipping one.
*.key
*.key.pub
keys/

# Generated deployment secrets (deploy/docker/.env holds the admin key and the
# delivery seed).
.env
.env.*
!.env.example

# Signed patch bundles — build output of `example/patchable_app/build.sh`.
# Not the bridge's `.mod` test fixtures, which are committed and checked by
# `dart run tool/gen_bridge_fixtures.dart --check`.
example/patchable_app/assets/*.bundle
